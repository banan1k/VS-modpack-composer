APP_NAME=VS Modpack Builder
HOST=127.0.0.1
PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
DB_URL=sqlite+aiosqlite:///./data/app.db
DATA_DIR=./data
MODDB_BASE_URL=https://mods.vintagestory.at
MODDB_API_BASE_URL=https://mods.vintagestory.at/api
HTTP_TIMEOUT_SECONDS=30
HTTP_CONCURRENCY=8
DOWNLOAD_CONCURRENCY=4
RELATION_MIN_CONFIDENCE=0.90

# Discord
DISCORD_TOKEN=
DISCORD_GUILD_ID=

# Comma-separated Discord Forum Channel IDs to scan.
# Example:
# DISCORD_FORUM_CHANNEL_IDS=123456789012345678,234567890123456789,345678901234567890
DISCORD_FORUM_CHANNEL_IDS=

# Optional: where published build links are posted.
DISCORD_BUILDS_CHANNEL_ID=

# Optional: machine-readable registry channel.
DISCORD_REGISTRY_CHANNEL_ID=
